{
  "name": "ms-en-linea-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de MS En Línea (MS Soluciones Tecnológicas)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-demo.js",
    "db:demo:reset": "node scripts/reset-demo.js",
    "db:demo:rebuild": "node scripts/reset-demo.js --confirmar && node scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "oracledb": "^6.7.0",
    "pdfkit": "^0.15.2",
    "zod": "^3.24.1"
  }
}
