# ===== Servidor =====
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma (en producción: el dominio real)
CORS_ORIGINS=http://localhost:4200
# URL pública de la app (se usa en enlaces de recuperación de contraseña)
APP_URL=http://localhost:4200

# ===== Oracle =====
DB_USER=ms_enlinea
DB_PASSWORD=CAMBIAR
# Ejemplo: localhost:1522/XEPDB1  |  host:1522/SERVICIO
DB_CONNECT_STRING=localhost:1522/XEPDB1
# Para Oracle Autonomous Database: alias de tnsnames.ora y carpeta del wallet descargado
DB_CONFIG_DIR=
DB_WALLET_LOCATION=
DB_WALLET_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== JWT =====
# Genere un secreto largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_MINIMO_32_CARACTERES_AAAAAAAA
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# ===== Archivos adjuntos =====
UPLOAD_DIR=./uploads
MAX_FILE_MB=5
MAX_FILES_PER_REQUEST=5

# ===== Correo (opcional) =====
# console = escribe el correo en el log del servidor (solo desarrollo) | smtp = envía por SMTP
MAIL_MODE=console
MAIL_FROM="AXORA SOLUTIONS <no-responder@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== Datos de prueba (solo para db:seed) =====
SEED_PASSWORD=CAMBIAR_MIN_10_CON_LETRAS_Y_NUMEROS

# ===== IA (opcional; clave de Google AI Studio, nunca la exponga al frontend) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_TIMEOUT_MS=120000

# ===== Datos del emisor en las cotizaciones PDF (solo se imprime lo que configure) =====
COMPANY_BRAND=AXORA SOLUTIONS
COMPANY_TAGLINE=Tu aliado tecnológico
COMPANY_LEGAL_NAME=
COMPANY_NIT=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEB=
# Condiciones comerciales separadas por "|"
QUOTE_TERMS=
QUOTE_EXECUTION_TIME=
QUOTE_WARRANTY=

# ===== Proveedor de IA del Diseñador de espacios: gemini (por defecto) u openai =====
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=medium

# ===== Demo (solo desarrollo; el seed se niega con NODE_ENV=production) =====
DEMO_EMAIL_DOMAIN=demo.msenlinea.com
DEMO_RESET_PASSWORDS=false

# Intentos permitidos de login/recuperación por IP cada 15 min (por defecto 20). Para demos/pruebas puede subirlo (p. ej. 200); en producción déjelo bajo.
# AUTH_RATE_LIMIT=200

# Registro público de clientes (POST /api/auth/registro). Ponga false para cerrarlo.
REGISTRO_PUBLICO=true
# Registros permitidos por hora y por IP
REGISTRO_RATE_LIMIT=10
